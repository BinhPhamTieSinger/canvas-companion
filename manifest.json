{
  "manifest_version": 3,
  "name": "Canvas Companion",
  "version": "0.5.0",
  "description": "A native Canvas academic timetable with canonical backgrounds, classes, examinations, assignment references and projects.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://vinuni.instructure.com/*"
  ],
  "background": {
    "service_worker": "src/worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Canvas Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://vinuni.instructure.com/*"
      ],
      "js": [
        "src/content/boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/main.js",
        "src/background/model.js",
        "src/background/renderer.js",
        "src/academic/canvas.js",
        "src/academic/dom.js",
        "src/academic/engine.js",
        "src/academic/forms.js",
        "src/academic/model.js",
        "src/academic/styles.js",
        "src/academic/time.js",
        "src/academic/widget.js",
        "src/background/glass.js",
        "src/academic/catalog.js",
        "src/academic/integration-ui.js",
        "src/catalog/vinuni-fall-2026.json",
        "src/academic/review.js",
        "src/ui/control-panel.js",
        "options.html",
        "src/ui/options.js",
        "src/ui/options.css",
        "src/assets/logo.svg",
        "src/assets/avatar-fallback.svg"
      ],
      "matches": [
        "https://vinuni.instructure.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  }
}
